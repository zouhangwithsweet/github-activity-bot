{
  "name": "github-activity-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prs": "node --env-file-if-exists=.env apps/bot/src/cli.ts",
    "lark": "node --env-file-if-exists=.env apps/bot/src/lark.ts",
    "check": "pnpm --dir apps/bot run check",
    "format": "pnpm --dir apps/bot run format",
    "test": "pnpm --dir apps/bot run test",
    "db:generate": "pnpm --dir apps/bot run db:generate",
    "desktop:build": "cd apps/desktop && go tool mygo build"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.6"
}
