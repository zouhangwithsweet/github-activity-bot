GH_TOKEN=
# Optional organization-scoped token for the same GitHub user.
# GH_ORG_TOKEN=
# Comma-separated repositories expected in PR queries.
# GH_EXPECTED_REPOS=owner/repo,owner/another-repo
# Optional write token and repository allowlist for owner-confirmed PR merges.
# GH_MERGE_TOKEN=
# GH_MERGE_REPOSITORIES=owner/repo,owner/another-repo
# GH_MERGE_METHOD=squash
# Optional private GitHub alerts, delivered to LARK_OWNER_OPEN_ID.
# LARK_GITHUB_ALERTS=1
# GH_ACTIVITY_POLL_SECONDS=120
# GH_TRACKED_PRS="owner/repo#123,owner/another-repo#456"
# Optional classic PAT with notifications scope for the same GitHub user.
# GH_NOTIFICATIONS_TOKEN=
# Optional, independent Star alerts. Use watched or accessible, and/or list specific repositories.
# GH_STAR_REPO_SOURCE=watched
# GH_STAR_REPOSITORIES=owner/repo,owner/another-repo
# GH_STAR_POLL_SECONDS=300
# Optional GitHub App webhook for a single repository. Keep the secret private.
# GH_WEBHOOK_REPOSITORY=owner/repo
# GH_WEBHOOK_SECRET=
# GH_WEBHOOK_PORT=8787
# Use 1 for individual Star webhook events when Star polling is also configured.
# GH_STAR_WEBHOOK=1
LARK_APP_ID=
LARK_APP_SECRET=
# Leave empty on the first run. DM the bot to see your open_id in the terminal.
LARK_OWNER_OPEN_ID=
# Optional test group. After adding the bot, @ it with /group-id to see the chat_id locally.
# LARK_TEST_GROUP_CHAT_ID=oc_...
# Optional local state directory (defaults to ~/.local/state/github-activity-bot).
# LARK_MEMORY_DIR=/absolute/path/to/private-state
# Optional when Codex is not on PATH.
# OAR_CODEX_BIN=/absolute/path/to/codex
