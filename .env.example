GH_TOKEN=
# Optional organization-scoped token for the same GitHub user.
# GH_ORG_TOKEN=
# Comma-separated repositories expected in PR queries.
# GH_EXPECTED_REPOS=owner/repo,owner/another-repo
LARK_APP_ID=
LARK_APP_SECRET=
